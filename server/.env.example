# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Auth ----
# Generate strong random values, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ---- Supabase ----
# Project Settings -> API.
# NOTE: this must be the API URL (https://<project-ref>.supabase.co), NOT the
# dashboard URL you see in the browser address bar.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service role key (server-only, NEVER expose to the browser).
# THIS FILE IS COMMITTED TO GIT — put the real key in server/.env, never here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Email (OTP + notifications) ----
# Leave SMTP_HOST empty in dev to print emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Antariksha Ops <no-reply@antariksha.local>"
# Where the public contact form delivers (falls back to ADMIN_EMAIL, then MAIL_FROM).
SUPPORT_EMAIL=

# ---- Google Drive (ticket permit storage) ----
# Service-account JSON key, raw or base64. Never stored in the database.
#   1. Google Cloud console -> enable the Drive API
#   2. Create a service account -> create a JSON key
#   3. Paste the whole JSON here (or its base64), on ONE line
# IMPORTANT: share the target folder with the service-account email as
# "Content manager". Use a SHARED DRIVE — service accounts have no personal
# storage quota, so a plain My Drive folder fails with storageQuotaExceeded.
GOOGLE_DRIVE_CREDENTIALS=
# Fallback root folder id (Settings -> Google Drive overrides this at runtime).
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ---- Security tuning ----
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
