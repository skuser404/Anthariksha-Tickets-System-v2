# Only needed for production builds where the API is on a different origin.
# In local dev this is unset and Vite proxies /api -> http://localhost:4000.
VITE_API_URL=https://your-api.up.railway.app

# Google Sign-In (optional). Same OAuth client ID as the server's
# GOOGLE_OAUTH_CLIENT_ID. This value is public by design - it identifies the
# app, it does not authorise anything. The sign-in button is hidden when unset.
VITE_GOOGLE_CLIENT_ID=
